# ── AI provider keys (at least ONE required for generation) ──
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CONTEXT_MODEL=llama-3.1-8b-instant

# ── Timeouts / budgets ──
PER_CALL_TIMEOUT_MS=45000
REQUEST_DEADLINE_BUDGET_MS=120000
MAX_ATTEMPTS_PER_PHASE=4
MAX_JSON_REPAIR_PER_PROVIDER=1

# ── API auth & CORS ──
# Comma-separated allowed keys for X-API-Key / Bearer auth. Empty = auth disabled (dev only)
API_KEYS=
# Comma-separated allowed CORS origins (e.g. https://my-resume.vercel.app,http://localhost:3000)
ALLOWED_ORIGINS=*

# ── Rendering ──
PDF_ENABLED=true
YTOTECH_URL=https://latex.ytotech.com/builds/sync

# ── Job idempotency store ──
# Backend choice: "json", "supabase", or "memory"
JOB_STORE_BACKEND=json
# For JSON file store (default):
JOB_STORE_PATH=data/jobs.json
# For Supabase store (persistent across multi-instance deploys):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=generation_jobs
